{{!
    @template local_extendednav/manage/origins

    The navigations as one column of links, with no groups, Activities among them, which opens the list of the kinds. A page of
    few navigations (compact), such as the one of a course, chooses them with a select instead. On a narrow screen the select is
    above the name of the page (origins_bar), so this column is only shown on a wide one.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "origins": [{"key": "course", "name": "Course navigation", "short": "Course", "url": "#", "active": true,
            "icon": "i/course", "component": "core", "off": false}],
        "originoptions": [{"name": "Course", "url": "#", "selected": true}]
    }
}}
<nav class="d-none d-lg-block" aria-label="{{#str}}navigations, local_extendednav{{/str}}" data-region="origins">
    {{#compact}}
        {{< local_extendednav/manage/origin_select }}{{$selectid}}len-origin-select-wide{{/selectid}}{{/ local_extendednav/manage/origin_select }}
    {{/compact}}
    {{^compact}}
        <div class="card" data-region="originlist">
            <div class="list-group list-group-flush">
                {{#origins}}{{> local_extendednav/manage/origin_item }}{{/origins}}
            </div>
        </div>
    {{/compact}}
</nav>
