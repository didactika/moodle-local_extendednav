{{!
    @template local_extendednav/manage/origins

    The navigations in groups, as a column of links, and as a select on a narrow screen. A page of few navigations (compact),
    such as the one of a course, has the select only. The select opens the address of the
    navigation chosen.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "origins": [
            {"label": "Courses", "items": [{"key": "course", "name": "Course navigation", "url": "#", "active": true, "icon": "i/course", "off": false}]}
        ],
        "originoptions": [{"name": "Course navigation", "url": "#", "selected": true}]
    }
}}
<nav aria-label="{{#str}}navigations, local_extendednav{{/str}}" data-region="origins">
    <div {{^compact}}class="d-lg-none"{{/compact}}>
        <label class="sr-only visually-hidden" for="len-origin-select">{{#str}}navigations, local_extendednav{{/str}}</label>
        <select class="custom-select form-select" id="len-origin-select" data-region="originselect">
            {{#originoptions}}<option value="{{url}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/originoptions}}
        </select>
    </div>
    {{^compact}}
    <div class="card d-none d-lg-block">
        {{#origins}}
            <p class="small fw-bold text-uppercase text-muted mb-0 px-3 pt-3 pb-1">{{label}}</p>
            <div class="list-group list-group-flush">
                {{#items}}
                    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 {{#active}}active{{/active}}" href="{{url}}" {{#active}}aria-current="page"{{/active}}>
                        {{#pix}}{{icon}}, core{{/pix}}
                        <span class="text-truncate">{{name}}</span>
                        <span class="badge rounded-pill text-bg-secondary ms-auto ml-auto" {{^off}}hidden{{/off}}>{{#str}}navigation_off, local_extendednav{{/str}}</span>
                    </a>
                {{/items}}
            </div>
        {{/origins}}
    </div>
    {{/compact}}
</nav>
