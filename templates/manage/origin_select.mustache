{{!
    @template local_extendednav/manage/origin_select

    The navigations in one select with a search, in the same order as the column, each by its short name. It opens the page of
    the navigation chosen.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {"originoptions": [{"name": "Course", "url": "#", "selected": true}, {"name": "Activities", "url": "#", "selected": false}]}
}}
<label class="sr-only visually-hidden" for="{{$selectid}}len-origin-select{{/selectid}}">{{#str}}navigations, local_extendednav{{/str}}</label>
<select class="custom-select form-select" id="{{$selectid}}len-origin-select{{/selectid}}" data-region="originselect" data-searchable
    data-search-label="{{#str}}search_navigations, local_extendednav{{/str}}" data-noresults="{{#str}}noresults, local_extendednav{{/str}}">
    {{#originoptions}}<option value="{{url}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/originoptions}}
</select>
