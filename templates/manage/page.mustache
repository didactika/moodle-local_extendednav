{{!
    @template local_extendednav/manage/page

    The management page: the navigations to the left (a select on a narrow screen), and to the right the name with its On and Off button, the scope
    of the changes, the actions and the list of the nodes of the navigation chosen.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "config": "{}",
        "name": "Course navigation",
        "origins": [
            {"label": "Course", "items": [{"key": "course", "name": "Course navigation", "url": "#", "active": true}]}
        ],
        "originoptions": [{"name": "Course navigation", "url": "#", "selected": true}],
        "enabled": true,
        "hasscopes": true,
        "scopename": "Whole site",
        "addurl": "#",
        "importurl": "#",
        "exporturl": "#",
        "exporteverythingurl": "#",
        "activityurl": "#",
        "canadd": true,
        "searchlabel": "Search nodes",
        "id": "len-nodes"
    }
}}
<div class="len" data-region="manage" data-config="{{config}}">
    <p class="text-muted mb-0">{{#str}}manage_nodes_desc, local_extendednav{{/str}}</p>

    <div data-region="layout">
        {{> local_extendednav/manage/origins }}

        <section class="d-grid gap-3" data-region="origin" aria-label="{{name}}">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <h2 class="h4 fw-bold mb-0">{{name}}</h2>
                    <button type="button" class="btn btn-sm rounded-pill {{#enabled}}btn-outline-success{{/enabled}}{{^enabled}}btn-outline-secondary{{/enabled}}" data-action="toggleenabled" aria-pressed="{{#enabled}}true{{/enabled}}{{^enabled}}false{{/enabled}}">
                        <span data-state="on" {{^enabled}}hidden{{/enabled}}>{{#pix}}i/checkedcircle, core{{/pix}} {{#str}}navigation_on, local_extendednav{{/str}}</span>
                        <span data-state="off" {{#enabled}}hidden{{/enabled}}>{{#pix}}i/uncheckedcircle, core{{/pix}} {{#str}}navigation_off, local_extendednav{{/str}}</span>
                    </button>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2" data-region="actions">
                    {{#canadd}}
                        <a class="btn btn-primary" href="{{addurl}}">{{#pix}}t/add, core{{/pix}} {{#str}}add_node, local_extendednav{{/str}}</a>
                    {{/canadd}}
                    <a class="btn btn-outline-secondary" href="{{importurl}}">{{#pix}}i/import, core{{/pix}} {{#str}}import, local_extendednav{{/str}}</a>
                    <span class="dropdown d-inline-flex position-relative" data-menu="export">
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-menu-toggle aria-haspopup="true" aria-expanded="false">{{#pix}}t/download, core{{/pix}} {{#str}}export, local_extendednav{{/str}}</button>
                        <span class="dropdown-menu dropdown-menu-end dropdown-menu-right show" hidden>
                            <a class="dropdown-item" href="{{exporturl}}">
                                <span class="d-block fw-bold">{{#str}}export_this, local_extendednav{{/str}}</span>
                                <span class="d-block small text-muted">{{name}}</span>
                            </a>
                            <span class="dropdown-divider d-block" role="separator"></span>
                            <a class="dropdown-item" href="{{exporteverythingurl}}">
                                <span class="d-block fw-bold">{{#str}}export_everything, local_extendednav{{/str}}</span>
                                <span class="d-block small text-muted">{{#str}}export_everything_help, local_extendednav{{/str}}</span>
                            </a>
                        </span>
                    </span>
                    <a class="btn btn-outline-secondary" href="{{activityurl}}">{{#pix}}i/report, core{{/pix}} {{#str}}activity_log, local_extendednav{{/str}}</a>
                </div>
            </div>

            {{#hasscopes}}
                <div class="d-flex flex-wrap align-items-center gap-2" data-region="scope">
                    <span class="fw-bold">{{#str}}applies_to, local_extendednav{{/str}}</span>
                    <span class="dropdown d-inline-flex" data-menu="scope">
                        <button type="button" class="custom-select form-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"><span data-region="menu-label">{{scopename}}</span></button>
                        <span class="dropdown-menu show" hidden>
                            <span class="d-block px-3 pt-2 pb-1">
                                <input type="search" class="form-control" data-region="scopesearch" autocomplete="off" aria-label="{{#str}}scope_search, local_extendednav{{/str}}" placeholder="{{#str}}scope_search, local_extendednav{{/str}}">
                            </span>
                            <span class="d-block" data-region="scopelist" role="listbox"></span>
                        </span>
                    </span>
                    <span class="small text-muted">{{#str}}applies_to_help, local_extendednav{{/str}}</span>
                </div>
            {{/hasscopes}}

            <section id="{{id}}" data-region="list" data-config="{{config}}" aria-label="{{searchlabel}}">
                <div class="card">
                    {{> local_extendednav/list/toolbar }}
                    <nav class="px-3 py-2 border-bottom" data-region="path" aria-label="{{#str}}tree_path, local_extendednav{{/str}}" hidden>
                        <ol class="breadcrumb mb-0"></ol>
                    </nav>
                    <div class="table-responsive" data-region="tablewrap" aria-busy="true">
                        <table class="table">
                            <caption class="sr-only visually-hidden">{{#str}}list_caption_nodes, local_extendednav{{/str}}</caption>
                            <tbody>
                                <tr aria-hidden="true"><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td></tr>
                                <tr aria-hidden="true"><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td></tr>
                                <tr aria-hidden="true"><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td><td><span class="placeholder"></span></td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div data-region="empty" hidden></div>
                    <div data-region="error" hidden></div>
                    <div class="px-3 py-2 border-top small text-muted" data-region="foot" role="status"><span data-region="count"></span></div>
                </div>
                <div class="card" data-region="floatbar" hidden role="region" aria-label="{{#str}}selection, local_extendednav{{/str}}">
                    <div class="d-flex flex-wrap align-items-center gap-3 px-3 py-2">
                        <span class="fw-bold" role="status" data-region="selectedcount"></span>
                                                <div class="d-flex flex-wrap gap-2 ms-auto ml-auto">
                            <button type="button" class="btn btn-outline-primary btn-sm" data-action="bulkshow" hidden>{{#pix}}t/hide, core{{/pix}} {{#str}}show_selected, local_extendednav{{/str}}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="bulkhide" hidden>{{#pix}}t/show, core{{/pix}} {{#str}}hide_selected, local_extendednav{{/str}}</button>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-action="bulkdelete" hidden>{{#pix}}t/delete, core{{/pix}} <span data-region="deletelabel"></span></button>
                        </div>
                        <button type="button" class="btn btn-link btn-icon btn-sm" data-action="clearselection" title="{{#str}}clear, moodle{{/str}}" aria-label="{{#str}}clear, moodle{{/str}}">{{#pix}}e/cancel, core{{/pix}}</button>
                    </div>
                </div>
            </section>
        </section>
    </div>
</div>
