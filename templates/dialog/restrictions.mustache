{{!
    @template local_extendednav/dialog/restrictions

    Body of the dialog that explains who sees a node: one row for each badge of its visibility, the badge on the left and
    the restriction in a sentence on the right, and the link to change them.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "items": [
            {"label": "Restricted", "tone": "warning", "detail": "Shown only to the roles chosen."},
            {"label": "Roles", "tone": "light", "detail": "Roles: editingteacher, teacher"}
        ],
        "editurl": "#"
    }
}}
<dl class="row mb-0" data-region="restrictions">
    {{#items}}
        <dt class="col-sm-4 px-0 py-2 mb-0 border-bottom"><span class="badge rounded-pill text-bg-{{tone}}">{{label}}</span></dt>
        <dd class="col-sm-8 px-0 py-2 mb-0 border-bottom">{{detail}}</dd>
    {{/items}}
</dl>
