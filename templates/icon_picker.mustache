{{!
    @template local_extendednav/icon_picker

    Body of the icon picker dialogue. The local_extendednav/icon_picker module fills the grid.

    Context variables required for this template:
    * tabs - Lists of icons, each with key, label and active

    Example context (json):
    {
        "tabs": [
            {"key": "moodle", "label": "Moodle icons", "active": true},
            {"key": "fontawesome", "label": "FontAwesome", "active": false},
            {"key": "brands", "label": "Brands", "active": false}
        ]
    }
}}
<div class="local-extendednav-iconpicker">
    <input type="search" class="form-control mb-3" data-region="search"
        placeholder="{{#str}} icon_search, local_extendednav {{/str}}" aria-label="{{#str}} icon_search, local_extendednav {{/str}}">
    <div class="btn-group mb-3" role="group" aria-label="{{#str}} icon_picker, local_extendednav {{/str}}">
        {{#tabs}}
        <button type="button" class="btn btn-outline-secondary{{#active}} active{{/active}}" data-tab="{{key}}"
            aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}">{{label}}</button>
        {{/tabs}}
    </div>
    <p class="text-muted" data-region="loading">{{#str}} icon_loading, local_extendednav {{/str}}</p>
    <div class="alert alert-info" data-region="unavailable" hidden>{{#str}} icon_unavailable, local_extendednav {{/str}}</div>
    <p class="text-muted" data-region="empty" hidden>{{#str}} icon_noresults, local_extendednav {{/str}}</p>
    <div class="local-extendednav-icongrid" data-region="grid"></div>
</div>
