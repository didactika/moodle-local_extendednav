{{!
    @template local_extendednav/list/toolbar

    The toolbar of the list of nodes: the search, the menu of the visibilities and the menu of the origins (nodes of Moodle or
    added), each with the nodes of each option, and the button that clears every filter. It keeps one row: when the menus do
    not fit they are grouped in one menu, Filters.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "id": "len-nodes",
        "searchlabel": "Search nodes"
    }
}}
<div class="d-flex align-items-center justify-content-between gap-3 px-3 py-2 border-bottom" data-region="filters">
    <div class="d-flex align-items-center gap-2 flex-grow-1">
        <form class="position-relative d-flex align-items-center" role="search" data-region="searchform" aria-label="{{searchlabel}}">
            {{#pix}}a/search, core{{/pix}}
            <label class="sr-only visually-hidden" for="{{id}}-search">{{searchlabel}}</label>
            <input class="form-control" type="search" id="{{id}}-search" data-region="search" placeholder="{{searchlabel}}" autocomplete="off">
        </form>
        <div class="d-flex align-items-center gap-2" data-region="filter-menus">
            <span class="dropdown d-inline-flex" data-menu="status" data-filter="status">
                <button type="button" class="custom-select form-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
                    aria-label="{{#str}}visibility, local_extendednav{{/str}}"><span data-region="menu-label" data-label="{{#str}}visibility, local_extendednav{{/str}}">{{#str}}visibility, local_extendednav{{/str}}</span></button>
                <button type="button" class="btn btn-link p-0" data-menu-clear hidden title="{{#str}}clear, moodle{{/str}}: {{#str}}visibility, local_extendednav{{/str}}"
                    aria-label="{{#str}}clear, moodle{{/str}}: {{#str}}visibility, local_extendednav{{/str}}">{{#pix}}e/cancel, core{{/pix}}</button>
                <span class="dropdown-menu show" role="group" aria-label="{{#str}}visibility, local_extendednav{{/str}}" hidden>
                    <label class="dropdown-item" for="{{id}}-vis-1">
                        <input type="checkbox" class="form-check-input" id="{{id}}-vis-1" data-option="1">
                        <span>{{#str}}vis_all, local_extendednav{{/str}}</span>
                        <span class="badge text-bg-secondary ms-auto ml-auto" data-count="visible"></span>
                    </label>
                    <label class="dropdown-item" for="{{id}}-vis-2">
                        <input type="checkbox" class="form-check-input" id="{{id}}-vis-2" data-option="2">
                        <span>{{#str}}vis_roles, local_extendednav{{/str}}</span>
                        <span class="badge text-bg-secondary ms-auto ml-auto" data-count="roles"></span>
                    </label>
                    <label class="dropdown-item" for="{{id}}-vis-0">
                        <input type="checkbox" class="form-check-input" id="{{id}}-vis-0" data-option="0">
                        <span>{{#str}}vis_hidden, local_extendednav{{/str}}</span>
                        <span class="badge text-bg-secondary ms-auto ml-auto" data-count="hidden"></span>
                    </label>
                </span>
            </span>
                <span class="dropdown d-inline-flex" data-menu="origin" data-filter="origin">
                <button type="button" class="custom-select form-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
                    aria-label="{{#str}}origin, local_extendednav{{/str}}"><span data-region="menu-label" data-label="{{#str}}origin, local_extendednav{{/str}}">{{#str}}origin, local_extendednav{{/str}}</span></button>
                <button type="button" class="btn btn-link p-0" data-menu-clear hidden title="{{#str}}clear, moodle{{/str}}: {{#str}}origin, local_extendednav{{/str}}"
                    aria-label="{{#str}}clear, moodle{{/str}}: {{#str}}origin, local_extendednav{{/str}}">{{#pix}}e/cancel, core{{/pix}}</button>
                <span class="dropdown-menu show" role="group" aria-label="{{#str}}origin, local_extendednav{{/str}}" hidden>
                    <label class="dropdown-item" for="{{id}}-origin-native">
                        <input type="checkbox" class="form-check-input" id="{{id}}-origin-native" data-option="native">
                        <span>{{#str}}origin_native, local_extendednav{{/str}}</span>
                        <span class="badge text-bg-secondary ms-auto ml-auto" data-count="native"></span>
                    </label>
                    <label class="dropdown-item" for="{{id}}-origin-custom">
                        <input type="checkbox" class="form-check-input" id="{{id}}-origin-custom" data-option="custom">
                        <span>{{#str}}origin_custom, local_extendednav{{/str}}</span>
                        <span class="badge text-bg-secondary ms-auto ml-auto" data-count="custom"></span>
                    </label>
                </span>
            </span>
            <span class="dropdown d-inline-flex" data-menu="restriction" data-filter="restriction">
                <button type="button" class="custom-select form-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
                    aria-label="{{#str}}restriction, local_extendednav{{/str}}"><span data-region="menu-label" data-label="{{#str}}restriction, local_extendednav{{/str}}">{{#str}}restriction, local_extendednav{{/str}}</span></button>
                <button type="button" class="btn btn-link p-0" data-menu-clear hidden title="{{#str}}clear, moodle{{/str}}: {{#str}}restriction, local_extendednav{{/str}}"
                    aria-label="{{#str}}clear, moodle{{/str}}: {{#str}}restriction, local_extendednav{{/str}}">{{#pix}}e/cancel, core{{/pix}}</button>
                <span class="dropdown-menu show" role="group" aria-label="{{#str}}restriction, local_extendednav{{/str}}" hidden>
                    {{#restrictions}}
                    <label class="dropdown-item" for="{{id}}-restriction-{{key}}">
                        <input type="checkbox" class="form-check-input" id="{{id}}-restriction-{{key}}" data-option="{{key}}">
                        <span>{{label}}</span>
                        <span class="badge text-bg-secondary ms-auto ml-auto" data-count="r_{{key}}"></span>
                    </label>
                    {{/restrictions}}
                </span>
            </span>
            <span class="dropdown" data-menu="filters" hidden>
                <button type="button" class="custom-select form-select" data-menu-toggle aria-haspopup="true" aria-expanded="false"
                    aria-label="{{#str}}filters{{/str}}">{{#pix}}i/filter, core{{/pix}} <span data-region="menu-label" data-label="{{#str}}filters{{/str}}">{{#str}}filters{{/str}}</span></button>
                <span class="dropdown-menu show dropdown-menu-end dropdown-menu-right" role="group" aria-label="{{#str}}filters{{/str}}" hidden>
                    <span class="d-flex align-items-center justify-content-between gap-2" data-region="filter-panel-head"><span class="small fw-bold text-uppercase text-muted">{{#str}}filters{{/str}}</span></span>
                    <span class="d-grid" data-region="filter-panel"></span>
                </span>
            </span>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
        <button type="button" class="btn btn-link btn-icon" data-action="clearfilters" disabled
            title="{{#str}}clear_filters, local_extendednav{{/str}}" aria-label="{{#str}}clear_filters, local_extendednav{{/str}}"><span data-region="icon-row">{{#pix}}i/reload, core{{/pix}}</span><span data-region="icon-group">{{#pix}}e/cancel, core{{/pix}}</span></button>
    </div>
</div>
