{{!
    @template local_extendednav/usermenu/panel

    Submenu panel matching Moodle's native user-menu carousel.

    @copyright  2026 Didactika
    @author     Miguel Rivas Morantes <miguelrivasmorantes@gmail.com>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "panelid": "carousel-item-extnav-example",
        "title": "Example Submenu",
        "items": [
            {
                "url": "https://example.com",
                "title": "Example Link",
                "icon": "fa-star",
                "newwindow": true
            }
        ]
    }
}}
<div id="{{panelid}}" role="menu" class="carousel-item submenu" tabindex="-1" aria-label="{{title}}">
    <div class="d-flex flex-column h-100">
        <div class="header">
            <button type="button" class="btn btn-icon carousel-navigation-link text-decoration-none text-body local-extendednav-back-btn" data-carousel-target-id="carousel-item-main" aria-label="{{#str}}usermenugoback, core{{/str}}">
                <span class="dir-rtl-hide">{{#pix}}i/arrow-left, core{{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}}i/arrow-right, core{{/pix}}</span>
            </button>
            <span class="pl-2" id="carousel-item-title-{{panelid}}">{{title}}</span>
        </div>
        <div class="dropdown-divider"></div>
        <div class="items h-100 overflow-auto" role="menu" aria-labelledby="carousel-item-title-{{panelid}}">
            {{#items}}
            <a href="{{url}}" class="dropdown-item ps-5" role="menuitem" tabindex="-1" {{#newwindow}}target="_blank"{{/newwindow}}>
                {{#icon}}
                <span class="carousel-navigation-link-icon">
                    <i class="icon fa {{icon}} fa-fw" aria-hidden="true"></i>
                </span>
                {{/icon}}
                {{title}}
            </a>
            {{/items}}
        </div>
    </div>
</div>
