{{!
    @template local_extendednav/mypreferences_group

    A group of the page Preferences with its items, each with a switch and two arrows. The group of the items outside every
    group (fixed) keeps its place at the end, so it has no arrows of its own.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {"key": "useraccount", "siteindex": 0, "name": "User account", "shown": true, "fixed": false,
        "items": [{"key": "editprofile", "siteindex": 0, "name": "Edit profile", "shown": true}]}
}}
<section class="card" data-region="group" data-key="{{key}}" data-siteindex="{{siteindex}}" aria-label="{{name}}">
    <div class="card-header d-flex align-items-center gap-2" data-region="row">
        <h2 class="h6 fw-bold mb-0 me-auto mr-auto text-truncate" data-region="name">{{name}}</h2>
        {{> local_extendednav/mypreferences_controls }}
    </div>
    <ul class="list-group list-group-flush" data-region="items">
        {{#items}}
            <li class="list-group-item d-flex align-items-center gap-2" data-region="item" data-key="{{key}}" data-siteindex="{{siteindex}}">
                <span class="me-auto mr-auto text-truncate" data-region="name">{{name}}</span>
                {{> local_extendednav/mypreferences_controls }}
            </li>
        {{/items}}
    </ul>
</section>
