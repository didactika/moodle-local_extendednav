{{!
    @template local_extendednav/mypreferences

    The page where a user orders and hides the groups and items of their own page Preferences: one card per group, with a
    switch that shows or hides it and two arrows that move it, and the same for each item inside. Every change is saved at once.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "preferencesurl": "#", "changed": true, "empty": false,
        "groups": [{"key": "useraccount", "name": "User account", "shown": true,
            "items": [{"key": "editprofile", "name": "Edit profile", "shown": true},
                {"key": "changepassword", "name": "Change password", "shown": false}]}]
    }
}}
<div class="len" data-region="mypreferences">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3" data-region="head">
        <p class="text-muted mb-0 me-auto mr-auto">{{#str}}personal_preferences_desc, local_extendednav{{/str}}</p>
        <a class="btn btn-secondary" href="{{preferencesurl}}">{{#str}}personal_preferences_see, local_extendednav{{/str}}</a>
        <button type="button" class="btn btn-secondary" data-action="reset" {{^changed}}disabled{{/changed}}>
            {{#pix}}i/reload, core{{/pix}}{{#str}}personal_preferences_reset, local_extendednav{{/str}}
        </button>
    </div>
    {{#empty}}
        <div class="text-center text-muted py-5">
            {{#pix}}t/preferences, core{{/pix}}
            <p class="mb-0 mt-2">{{#str}}personal_preferences_empty, local_extendednav{{/str}}</p>
        </div>
    {{/empty}}
    <div class="d-grid gap-3" data-region="groups">
        {{#groups}}
            {{> local_extendednav/mypreferences_group }}
        {{/groups}}
    </div>
    {{#loose}}
        <div class="d-grid mt-3" data-region="loose">
            {{> local_extendednav/mypreferences_group }}
        </div>
    {{/loose}}
</div>
