{{!
    @template local_extendednav/activity/table

    One page of the activity log of a navigation: when, the node with the fields its change touched, the action, who and from
    where. The fields open the dialog of the change, with each value before and after. The time sorts the rows.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "rows": [
            {
                "id": 41, "time": "24/11/26, 10:42", "user": "Admin User", "userurl": "#", "action": "updated",
                "actionlabel": "Updated", "tone": "info", "nodekey": "myhome", "editurl": "#", "ip": "192.0.2.1",
                "changes": [{"field": "Visibility", "before": "Visible to everyone", "after": "Not visible"}],
                "changedfields": "Visibility", "changeslabel": "See the changes of myhome"
            }
        ]
    }
}}
<table class="table">
    <caption class="sr-only visually-hidden">{{#str}}list_caption_activity, local_extendednav{{/str}}</caption>
    <thead>
        <tr>
            <th scope="col" data-sort="time"><button type="button" class="btn btn-link" data-focuskey="sort-time">{{#str}}time{{/str}}</button></th>
            <th scope="col">{{#str}}activity_node, local_extendednav{{/str}}</th>
            <th scope="col" class="d-none d-md-table-cell">{{#str}}action{{/str}}</th>
            <th scope="col" class="d-none d-md-table-cell">{{#str}}user{{/str}}</th>
            <th scope="col" class="d-none d-lg-table-cell">{{#str}}ip_address{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
            <tr>
                <td class="text-nowrap">{{time}}</td>
                <th scope="row">
                    <span class="d-flex flex-column overflow-hidden">
                        {{#editurl}}<a class="text-truncate" href="{{editurl}}"><code>{{nodekey}}</code></a>{{/editurl}}
                        {{^editurl}}<code class="text-truncate" title="{{nodekey}}">{{nodekey}}</code>{{/editurl}}
                        {{#changedfields}}<button type="button" class="btn btn-link p-0 small text-start text-left text-truncate" data-action="changes" data-id="{{id}}" title="{{changeslabel}}">{{changedfields}}</button>{{/changedfields}}
                        <span class="d-flex d-md-none align-items-center gap-2 small text-muted text-truncate"><span class="badge rounded-pill text-bg-{{tone}}">{{actionlabel}}</span> {{user}}</span>
                    </span>
                </th>
                <td class="d-none d-md-table-cell"><span class="badge rounded-pill text-bg-{{tone}}">{{actionlabel}}</span></td>
                <td class="d-none d-md-table-cell text-nowrap">{{#userurl}}<a href="{{userurl}}">{{user}}</a>{{/userurl}}{{^userurl}}-{{/userurl}}</td>
                <td class="d-none d-lg-table-cell text-nowrap">{{ip}}{{^ip}}-{{/ip}}</td>
            </tr>
        {{/rows}}
    </tbody>
</table>
