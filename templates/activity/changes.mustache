{{!
    @template local_extendednav/activity/changes

    Body of the dialog of a change of the activity log: when and who, and a row for each field it touched, with its value
    before and after.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "time": "24/11/26, 10:42", "user": "Admin User",
        "changes": [{"field": "Visibility", "before": "Visible to everyone", "after": "Not visible"}]
    }
}}
<p class="text-muted small mb-2">{{time}}{{#user}} · {{user}}{{/user}}</p>
<div class="table-responsive">
    <table class="table table-sm mb-0">
        <thead>
            <tr>
                <th scope="col">{{#str}}change_field, local_extendednav{{/str}}</th>
                <th scope="col">{{#str}}change_before, local_extendednav{{/str}}</th>
                <th scope="col">{{#str}}change_after, local_extendednav{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#changes}}
                <tr>
                    <th scope="row" class="fw-bold">{{field}}</th>
                    <td class="text-break">{{before}}</td>
                    <td class="text-break">{{after}}</td>
                </tr>
            {{/changes}}
        </tbody>
    </table>
</div>
