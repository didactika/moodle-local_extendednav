{{!
    @template local_extendednav/activity_log

    Table of the activity log in a card, with the number of entries and the paging bar in the footer.

    Context variables required for this template:
    * table - HTML of the table
    * count - Text with the number of entries
    * pagingbar - HTML of the paging bar, or empty

    Example context (json):
    {
        "table": "<table class=\"generaltable\"><tbody><tr><td>Navigation node updated</td></tr></tbody></table>",
        "count": "12 entries",
        "pagingbar": ""
    }
}}
<div class="card local-extendednav-activity-card">
    <div class="card-body p-0">
        {{{table}}}
    </div>
    <div class="card-footer d-flex flex-wrap align-items-center justify-content-between local-extendednav-activity-footer">
        <span class="text-muted">{{count}}</span>
        {{{pagingbar}}}
    </div>
</div>
