{{!
    @template local_extendednav/manage_nodes

    Table of nodes in a card. The footer shows the number of nodes and, while nodes are
    selected, the bulk actions; it stays at the bottom of the screen on long lists.

    Context variables required for this template:
    * sesskey - Session key
    * menu - Menu key
    * exporturl - URL the selected nodes are exported to
    * table - HTML of the table of nodes
    * count - Text with the number of nodes

    Example context (json):
    {
        "sesskey": "abc123",
        "menu": "primary",
        "exporturl": "https://example.com/local/extendednav/export.php",
        "table": "<table class=\"generaltable\"><tbody><tr><td>Home</td></tr></tbody></table>",
        "count": "5 items"
    }
}}
<form id="bulk-form" method="post" action="manage.php" class="card local-extendednav-nodes-card">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="menu" value="{{menu}}">
    <input type="hidden" name="action" value="bulkdelete">
    <div class="card-body p-0">
        {{{table}}}
    </div>
    <div class="card-footer d-flex flex-wrap align-items-center justify-content-between local-extendednav-nodes-footer">
        <span class="text-muted">{{count}}</span>
        <div class="d-none local-extendednav-bulkbar" id="bulk-actions-bar">
            <span class="font-weight-bold fw-bold mr-2 me-2"><span id="bulk-count">0</span> {{#str}} nodes_selected, local_extendednav {{/str}}</span>
            <button type="submit" formaction="{{exporturl}}" class="btn btn-outline-secondary">{{#pix}} t/download, core {{/pix}}{{#str}} export_selected, local_extendednav {{/str}}</button>
            <button type="button" class="btn btn-outline-danger" data-action="bulk-delete">{{#pix}} t/delete, core {{/pix}}{{#str}} bulk_delete, local_extendednav {{/str}}</button>
        </div>
    </div>
</form>
