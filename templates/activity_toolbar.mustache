{{!
    @template local_extendednav/activity_toolbar

    Menu tabs and back button of the activity log.

    Context variables required for this template:
    * tabs - Menus, each with name, url and active
    * backurl - URL of the management page

    Example context (json):
    {
        "tabs": [
            {"name": "Primary navigation", "url": "https://example.com/local/extendednav/activity.php?menu=primary", "active": true},
            {"name": "User menu", "url": "https://example.com/local/extendednav/activity.php?menu=usermenu", "active": false}
        ],
        "backurl": "https://example.com/local/extendednav/manage.php?menu=primary"
    }
}}
<div class="d-flex flex-wrap align-items-end mb-3 local-extendednav-toolbar">
    <ul class="nav nav-tabs flex-grow-1">
        {{#tabs}}
            <li class="nav-item">
                <a href="{{url}}" class="nav-link{{#active}} active{{/active}}"{{#active}} aria-current="page"{{/active}}>{{name}}</a>
            </li>
        {{/tabs}}
    </ul>
    <div class="d-flex flex-wrap local-extendednav-actions">
        <a href="{{backurl}}" class="btn btn-outline-secondary">{{#pix}} t/left, core {{/pix}}{{#str}} back_to_nodes, local_extendednav {{/str}}</a>
    </div>
</div>
