{{!
    @template local_extendednav/mypreferences_controls

    The controls of a group or an item of the page Preferences: a switch that shows or hides it and two arrows that move it.

    @copyright  2026 Didactika.org
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {"key": "editprofile", "name": "Edit profile", "shown": true}
}}
<div class="form-check form-switch custom-control custom-switch mb-0">
    <input class="form-check-input custom-control-input" type="checkbox" role="switch" id="len-pref-{{key}}" data-action="toggle" {{#shown}}checked{{/shown}}>
    <label class="form-check-label custom-control-label" for="len-pref-{{key}}"><span class="sr-only visually-hidden">{{#str}}personal_preferences_show, local_extendednav, {{name}}{{/str}}</span></label>
</div>
{{^fixed}}
<span class="d-inline-flex" data-region="actions">
    <button type="button" class="btn btn-link btn-icon" data-action="up" title="{{#str}}moveup{{/str}}" aria-label="{{#str}}moveup{{/str}}: {{name}}">{{#pix}}t/up, core{{/pix}}</button>
    <button type="button" class="btn btn-link btn-icon" data-action="down" title="{{#str}}movedown{{/str}}" aria-label="{{#str}}movedown{{/str}}: {{name}}">{{#pix}}t/down, core{{/pix}}</button>
</span>
{{/fixed}}
