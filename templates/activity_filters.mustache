{{!
    @template local_extendednav/activity_filters

    Filters of the activity log.

    Context variables required for this template:
    * menu - Menu key
    * datefrom - First day shown, as YYYY-MM-DD, or empty
    * dateto - Last day shown, as YYYY-MM-DD, or empty
    * actions - Actions to filter by, each with value, name and selected
    * clearurl - URL that clears the filters

    Example context (json):
    {
        "menu": "primary",
        "datefrom": "2026-10-01",
        "dateto": "",
        "actions": [
            {"value": "created", "name": "Created", "selected": false},
            {"value": "updated", "name": "Updated", "selected": true},
            {"value": "deleted", "name": "Deleted", "selected": false}
        ],
        "clearurl": "https://example.com/local/extendednav/activity.php?menu=primary"
    }
}}
<div class="card mb-3">
    <div class="card-body">
        <form method="get" action="activity.php" class="local-extendednav-filterbar">
            <input type="hidden" name="menu" value="{{menu}}">
            <div class="d-flex align-items-center local-extendednav-filter-field">
                <label for="local-extendednav-datefrom" class="mb-0">{{#str}} filter_datefrom, local_extendednav {{/str}}</label>
                <input type="date" id="local-extendednav-datefrom" name="datefrom" value="{{datefrom}}" class="form-control">
            </div>
            <div class="d-flex align-items-center local-extendednav-filter-field">
                <label for="local-extendednav-dateto" class="mb-0">{{#str}} filter_dateto, local_extendednav {{/str}}</label>
                <input type="date" id="local-extendednav-dateto" name="dateto" value="{{dateto}}" class="form-control">
            </div>
            <div>
                <label for="local-extendednav-action" class="sr-only visually-hidden">{{#str}} filter_action, local_extendednav {{/str}}</label>
                <select id="local-extendednav-action" name="action" class="custom-select form-select">
                    <option value="">{{#str}} filter_action_any, local_extendednav {{/str}}</option>
                    {{#actions}}
                        <option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>
                    {{/actions}}
                </select>
            </div>
            <button type="submit" class="btn btn-primary">{{#str}} apply, local_extendednav {{/str}}</button>
            <a href="{{clearurl}}" class="btn btn-outline-secondary">{{#str}} clear_filters, local_extendednav {{/str}}</a>
        </form>
    </div>
</div>
