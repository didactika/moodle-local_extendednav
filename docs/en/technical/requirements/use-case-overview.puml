!theme plain
skinparam linetype polyline
left to right direction

actor "Administrator" as A_Administrator
actor "System" as A_System

rectangle "local_extendednav" {
  package "Navigation" {
    usecase "Add, change or delete an item" as UC_manageNodes
    usecase "Reorder the items" as UC_reorderNodes
    usecase "Import and export items" as UC_importNodes
  }
  package "Display" {
    usecase "Show the menus of a user" as UC_showMenus
    usecase "Block the pages of hidden items" as UC_blockUrl
  }
}

A_Administrator --> UC_manageNodes
A_Administrator --> UC_reorderNodes
A_Administrator --> UC_importNodes
A_System --> UC_showMenus
A_System --> UC_blockUrl

@enduml
