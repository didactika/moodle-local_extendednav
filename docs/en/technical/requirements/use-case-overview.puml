@startuml
' generated by rup-flow (index); edit the use-case cards, not this file
!theme plain
skinparam linetype polyline
left to right direction

actor "Administrator" as A_Administrator
actor "Integration" as A_Integration
actor "System" as A_System
actor "User" as A_User

rectangle "local_extendednav" {
  package "Navigation" {
    usecase "Add, change or delete an item" as UC_manageNodes
    usecase "Reorder the items" as UC_reorderNodes
    usecase "Import and export items" as UC_importNodes
    usecase "Customise a secondary navigation" as UC_customiseSecondaryNavigation
    usecase "Change a navigation for a category, a course or an activity" as UC_setScopeException
    usecase "Find the items of the navigation of each kind of activity" as UC_discoverActivityItems
    usecase "Arrange the Preferences page" as UC_arrangePreferences
    usecase "Manage the navigations from outside Moodle" as UC_manageByWebService
  }
  package "Display" {
    usecase "Show the menus of a user" as UC_showMenus
    usecase "Block the pages of hidden items" as UC_blockUrl
  }
  package "Maintenance" {
    usecase "Clean up the activity log" as UC_cleanActivityLog
    usecase "Back up and restore the changes of a course" as UC_backUpChanges
  }
}

A_Administrator --> UC_manageNodes
A_Administrator --> UC_reorderNodes
A_Administrator --> UC_importNodes
A_System --> UC_showMenus
A_System --> UC_blockUrl
A_Administrator --> UC_customiseSecondaryNavigation
A_Administrator --> UC_setScopeException
A_System --> UC_discoverActivityItems
A_User --> UC_arrangePreferences
A_System --> UC_cleanActivityLog
A_System --> UC_backUpChanges
A_Integration --> UC_manageByWebService

@enduml
