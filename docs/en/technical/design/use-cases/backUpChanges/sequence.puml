@startuml
title UC-011 Back up and restore — sequence
participant "backup plugin" as backup
participant "restore plugin" as restore
database "local_extendednav" as table
backup -> table : nodes of the context
backup --> backup : the backup
restore -> table : keys the context already sets (one query)
restore -> restore : keep the new ones
restore -> restore : map grades, activities and groups
restore -> table : insert_records (all at once)
@enduml
