@startuml
title UC-012 Manage the navigations from outside Moodle — sequence
actor Integration as client
participant "manage_navigation" as service
participant "node_service" as base
participant "validator" as validator
database "local_extendednav" as table
client -> service : save_node(menu, context, key, fields)
service -> base : require_scope(menu, context, change)
service -> validator : validate(record, others)
validator --> service : errors or ok
service -> table : create or update
service --> client : id, created, warnings
@enduml
