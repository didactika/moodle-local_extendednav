@startuml
title UC-010 Clean up the activity log — sequence
participant "settings" as settings
participant "clean_activity_log" as task
database "logstore_standard_log" as log
settings -> task : sync()
task -> task : enable or disable the scheduled task
...once a day...
task -> log : MIN(timecreated), the first time
loop each day up to the time kept, while time is left
  task -> log : ids of the plugin where timecreated is in the day (1000)
  task -> log : delete by id
  task -> task : set_config(logretention_done)
end
@enduml
