@startuml
!theme plain
hide empty members
skinparam linetype polyline
top to bottom direction

package "Entry points" {
  class "manage.php, edit.php, import.php" as pages
  class reorder_nodes
  class get_icons
  class hooks
  class observer
}
package "Services" {
  class manager
  class validator
  class importer
  class repository
  class access
  class access_guard
  class url_helper
  class menu_manager
  class yaml
}
package "Menus" {
  class primary
  class usermenu
}

pages --> manager
pages --> importer
reorder_nodes --> manager
hooks --> menu_manager
hooks --> access_guard
observer --> manager
manager --> repository
manager --> validator
importer --> validator
importer --> yaml
access_guard --> access
access_guard --> url_helper
menu_manager --> primary
menu_manager --> usermenu
primary --> access
usermenu --> access

@enduml
