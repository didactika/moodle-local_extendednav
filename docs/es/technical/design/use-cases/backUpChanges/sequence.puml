@startuml
title UC-011 Respaldar y restaurar — secuencia
participant "plugin de copia" as backup
participant "plugin de restauración" as restore
database "local_extendednav" as table
backup -> table : nodos del contexto
backup --> backup : la copia
restore -> table : claves que el contexto ya establece (una consulta)
restore -> restore : conservar las nuevas
restore -> restore : asignar calificaciones, actividades y grupos
restore -> table : insert_records (todas de una vez)
@enduml
