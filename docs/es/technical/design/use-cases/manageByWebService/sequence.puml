@startuml
title UC-012 Gestionar las navegaciones desde fuera de Moodle — secuencia
actor Integración as client
participant "manage_navigation" as service
participant "node_service" as base
participant "validator" as validator
database "local_extendednav" as table
client -> service : save_node(menú, contexto, clave, campos)
service -> base : require_scope(menú, contexto, cambio)
service -> validator : validate(registro, otros)
validator --> service : errores o correcto
service -> table : crear o actualizar
service --> client : id, creado, avisos
@enduml
