@startuml
title UC-009 Organizar la página de preferencias — secuencia
actor Usuario as user
participant "context.php" as page
participant "context_scope" as scope
participant "manager" as manager
participant "preferences_injector" as injector
user -> page : abrir la lista
page -> scope : from_id(contexto del usuario), require_view()
user -> page : ocultar una opción
page -> scope : require_scope(changevisibility)
page -> manager : set_visibility(menú preferences, contexto)
manager --> page : excepción guardada
user -> injector : abrir Preferencias
injector -> injector : read() las secciones de Moodle
injector -> injector : apply() el sitio y el usuario
injector --> user : la página organizada
@enduml
