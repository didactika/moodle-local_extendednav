@startuml
' generated by rup-flow (index); edit the use-case cards, not this file
!theme plain
skinparam linetype polyline
left to right direction

actor "Administrator" as A_Administrator
actor "Integration" as A_Integration
actor "System" as A_System
actor "User" as A_User

rectangle "local_extendednav" {
  package "Navigation" {
    usecase "Añadir, cambiar o eliminar un elemento" as UC_manageNodes
    usecase "Reordenar los elementos" as UC_reorderNodes
    usecase "Importar y exportar elementos" as UC_importNodes
    usecase "Personalizar una navegación secundaria" as UC_customiseSecondaryNavigation
    usecase "Cambiar una navegación para una categoría, un curso o una actividad" as UC_setScopeException
    usecase "Buscar los elementos de la navegación de cada tipo de actividad" as UC_discoverActivityItems
    usecase "Organizar la página de preferencias" as UC_arrangePreferences
    usecase "Gestionar las navegaciones desde fuera de Moodle" as UC_manageByWebService
  }
  package "Display" {
    usecase "Mostrar los menús de un usuario" as UC_showMenus
    usecase "Bloquear las páginas de los elementos ocultos" as UC_blockUrl
  }
  package "Maintenance" {
    usecase "Depurar el registro de actividad" as UC_cleanActivityLog
    usecase "Respaldar y restaurar los cambios de un curso" as UC_backUpChanges
  }
}

A_Administrator --> UC_manageNodes
A_Administrator --> UC_reorderNodes
A_Administrator --> UC_importNodes
A_System --> UC_showMenus
A_System --> UC_blockUrl
A_Administrator --> UC_customiseSecondaryNavigation
A_Administrator --> UC_setScopeException
A_System --> UC_discoverActivityItems
A_User --> UC_arrangePreferences
A_System --> UC_cleanActivityLog
A_System --> UC_backUpChanges
A_Integration --> UC_manageByWebService

@enduml
