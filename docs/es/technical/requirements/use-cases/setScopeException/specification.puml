@startuml
!theme plain
skinparam linetype polyline
hide empty description

state "setScopeException" as setScopeException {
  [*] --> Sitio
  state "Sitio" as Sitio : La lista muestra la navegación del sitio
  state "Ámbito" as mbito : La lista muestra lo que ve el ámbito
  state "Cambiando" as Cambiando : Se está guardando una excepción
  Sitio --> mbito
  mbito --> Cambiando
  Cambiando --> Sitio
}

@enduml
